generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Brand {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String
  code      String   @unique(map: "Brand_code_key")
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime
  item      Item[]

  @@map("brand")
}

model Category {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String
  code        String   @unique(map: "Category_code_key")
  createdAt   DateTime @default(now())
  isDeleted   Boolean  @default(false)
  updatedAt   DateTime
  description String?
  item        Item[]

  @@map("category")
}

model Item {
  id         String     @id @default(uuid()) @db.VarChar(36)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime
  brandId    String     @db.VarChar(36)
  categoryId String     @db.VarChar(36)
  itemCode   String     @unique(map: "Item_itemCode_key")
  name       String
  imageUrl   String
  quantity   Int        @default(0)
  brand      Brand      @relation(fields: [brandId], references: [id], map: "Item_brandId_fkey")
  category   Category   @relation(fields: [categoryId], references: [id], map: "Item_categoryId_fkey")
  loan       Loan[]
  stockin    StockIn[]
  stockout   StockOut[]

  @@index([brandId], map: "Item_brandId_fkey")
  @@index([categoryId], map: "Item_categoryId_fkey")
  @@map("item")
}

model Loan {
  id                           String      @id @default(uuid()) @db.VarChar(36)
  itemId                       String      @db.VarChar(36)
  qty                          Int
  approvedAt                   DateTime?
  approvedById                 String?     @db.VarChar(36)
  createdAt                    DateTime    @default(now())
  status                       LoanStatus  @default(PENDING)
  updatedAt                    DateTime
  userId                       String      @db.VarChar(36)
  borrowerName                 String?
  endDate                      DateTime?
  purpose                      String?
  rejectionReason              String?
  startDate                    DateTime?
  user_loan_approvedByIdTouser User?       @relation("loan_approvedByIdTouser", fields: [approvedById], references: [id], map: "Loan_approvedById_fkey")
  item                         Item        @relation(fields: [itemId], references: [id], map: "Loan_itemId_fkey")
  user_loan_userIdTouser       User        @relation("loan_userIdTouser", fields: [userId], references: [id], map: "Loan_userId_fkey")

  @@index([approvedById], map: "Loan_approvedById_fkey")
  @@index([itemId], map: "Loan_itemId_fkey")
  @@index([userId], map: "Loan_userId_fkey")
  @@map("loan")
}

model StockIn {
  id         String   @id @default(uuid()) @db.VarChar(36)
  itemId     String   @db.VarChar(36)
  qty        Int
  date       DateTime @default(now())
  supplierId String   @db.VarChar(36)
  item       Item     @relation(fields: [itemId], references: [id], map: "StockIn_itemId_fkey")
  supplier   Supplier  @relation(fields: [supplierId], references: [id], map: "StockIn_supplierId_fkey")

  @@index([itemId], map: "StockIn_itemId_fkey")
  @@index([supplierId], map: "StockIn_supplierId_fkey")
}

model StockOut {
  id     String   @id @default(uuid()) @db.VarChar(36)
  itemId String   @db.VarChar(36)
  qty    Int
  date   DateTime @default(now())
  reason String?
  item   Item     @relation(fields: [itemId], references: [id], map: "StockOut_itemId_fkey")

  @@index([itemId], map: "StockOut_itemId_fkey")
  @@map("stockout")
}

model Supplier {
  id      String    @id @default(uuid()) @db.VarChar(36)
  name    String
  phone   String?
  address String?
  stockin StockIn[]

  @@map("supplier")
}

model User {
  id                           String    @id @default(uuid()) @db.VarChar(36)
  name                         String
  email                        String    @unique(map: "User_email_key")
  password                     String
  role                         Role      @default(PEMINJAM)
  createdAt                    DateTime  @default(now())
  isActive                     Boolean   @default(true)
  updatedAt                    DateTime
  isDeleted                    Boolean   @default(false)
  loan_loan_approvedByIdTouser Loan[]    @relation("loan_approvedByIdTouser")
  loan_loan_userIdTouser       Loan[]    @relation("loan_userIdTouser")

  @@map("user")
}

enum Role {
  SUPERADMIN
  ADMIN
  PETUGAS_GUDANG
  PIMPINAN
  PEMINJAM

  @@map("user_role")
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED

  @@map("loan_status")
}
